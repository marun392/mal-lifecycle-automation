# ---------------------------------------------------------------------------
# mal-lifecycle-automation configuration
# Every integration has a <SERVICE>_MODE switch: "mock" (default) or "live".
# Secrets are only ever read from the environment - never commit a real .env.
# ---------------------------------------------------------------------------

# ---- Okta (free developer org: https://developer.okta.com/signup/) ---------
OKTA_MODE=mock
OKTA_DOMAIN=dev-123456.okta.com
OKTA_API_TOKEN=                      # Security > API > Tokens (SSWS token)
OKTA_OFFBOARD_ACTION=suspend         # suspend | deactivate

# ---- Google Workspace (Admin SDK Directory API) ----------------------------
GWS_MODE=mock
# Option A: service account JSON with domain-wide delegation, impersonating an admin
GWS_SERVICE_ACCOUNT_FILE=./secrets/gws-service-account.json
GWS_ADMIN_EMAIL=admin@yourdomain.com
# Option B (quick test): a short-lived OAuth access token, e.g. from
#   gcloud auth print-access-token  (needs admin.directory.user + user.security scopes)
GWS_ACCESS_TOKEN=
GWS_ORG_UNIT_PATH=/

# ---- 1Password --------------------------------------------------------------
OP_MODE=mock
# SCIM bridge (user + group membership management)
OP_SCIM_URL=https://op-scim-bridge.yourdomain.com
OP_SCIM_TOKEN=                       # bearer token from the SCIM bridge setup
# Connect server (optional, read-only vault lookup)
OP_CONNECT_HOST=http://localhost:8080
OP_CONNECT_TOKEN=
# Events API (optional, read-only audit confirmation). Host is .com / .eu / .ca
OP_EVENTS_HOST=https://events.1password.com
OP_EVENTS_TOKEN=
# Shared vault(s) whose existence is verified during onboarding
OP_SHARED_VAULTS=Engineering

# ---- MDM: Jamf Pro (mocked by default) --------------------------------------
MDM_MODE=mock
JAMF_URL=https://yourorg.jamfcloud.com
JAMF_USERNAME=api-automation
JAMF_PASSWORD=
JAMF_INVITATION_DAYS=30

# ---- Alerts: Slack incoming webhook or SMTP email ---------------------------
ALERT_MODE=mock
ALERT_CHANNEL=slack                  # slack | email
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=it-security@yourdomain.com
ALERT_EMAIL_TO=security-alerts@yourdomain.com,it@yourdomain.com
